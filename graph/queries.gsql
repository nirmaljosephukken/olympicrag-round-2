USE GRAPH @GRAPH@

// ---------- similarity search (native HNSW vector index) ----------
CREATE OR REPLACE QUERY chunk_search(LIST<FLOAT> qv, INT k) FOR GRAPH @GRAPH@ SYNTAX v3 {
  MapAccum<VERTEX, FLOAT> @@dist;
  R = vectorSearch({Chunk.emb}, qv, k, {distance_map: @@dist});
  PRINT R[R.id AS id, R.doc_id AS doc_id, R.text AS text] AS hits;
  PRINT @@dist AS distances;
}

// GraphRAG: vector search restricted to the chunks of graph-selected documents
CREATE OR REPLACE QUERY chunk_search_in_docs(LIST<FLOAT> qv, SET<STRING> doc_ids, INT k) FOR GRAPH @GRAPH@ SYNTAX v3 {
  MapAccum<VERTEX, FLOAT> @@dist;
  D = {Doc.*};
  D = SELECT d FROM D:d WHERE d.id IN doc_ids;
  C = SELECT c FROM D:d -(HAS_CHUNK)- Chunk:c;
  R = vectorSearch({Chunk.emb}, qv, k, {candidate_set: C, distance_map: @@dist});
  PRINT R[R.id AS id, R.doc_id AS doc_id, R.text AS text] AS hits;
  PRINT @@dist AS distances;
}

// ---------- document retrieval ----------
CREATE OR REPLACE QUERY doc_chunks(STRING doc_id, INT max_idx) FOR GRAPH @GRAPH@ {
  S = {Doc.*};
  S = SELECT d FROM S:d WHERE d.id == doc_id;
  C = SELECT c FROM S:d -(HAS_CHUNK)- Chunk:c WHERE c.idx <= max_idx ORDER BY c.idx ASC;
  PRINT S[S.title AS title, S.url AS url, S.kind AS kind] AS doc;
  PRINT C[C.idx AS idx, C.text AS text] AS chunks;
}

// ---------- structured event search over the graph ----------
// Empty string / -1 means "no filter". Matching uses normalised (lower-case, accent/dash-free) attributes.
CREATE OR REPLACE QUERY find_events(STRING sport_norm, INT year, STRING season, STRING venue_norm,
                                    STRING date_norm, STRING event_norm, INT lim) FOR GRAPH @GRAPH@ {
  SetAccum<VERTEX<Event>> @@out;
  G = {Games.*};
  IF year > 0 THEN
    G = SELECT g FROM G:g WHERE g.year == year AND (season == "" OR g.season == season);
  END;
  E = SELECT e FROM G:g -(IN_GAMES)- Event:e
      WHERE (sport_norm == "" OR e.sport_norm == sport_norm)
        AND (venue_norm == "" OR e.venue_norm LIKE "%" + venue_norm + "%")
        AND (date_norm == "" OR e.date_norm LIKE "%" + date_norm + "%")
        AND (event_norm == "" OR e.event_norm LIKE "%" + event_norm + "%")
        AND (season == "" OR e.season == season)
      LIMIT lim;
  PRINT E[E.title AS title, E.sport AS sport, E.year AS year, E.season AS season, E.venue AS venue,
          E.date_text AS date, E.competitors AS competitors, E.nations AS nations, E.gold AS gold] AS events;
}

// Venue-centred lookup: Venue -> events held there (multi-hop: venue + date -> event -> medallist)
CREATE OR REPLACE QUERY events_at_venue(STRING venue_norm, STRING date_norm, INT year) FOR GRAPH @GRAPH@ {
  V = {Venue.*};
  V = SELECT v FROM V:v WHERE v.id LIKE "%" + venue_norm + "%";
  E = SELECT e FROM V:v -(AT_VENUE)- Event:e
      WHERE (date_norm == "" OR e.date_norm LIKE "%" + date_norm + "%") AND (year <= 0 OR e.year == year);
  PRINT V[V.name AS name] AS venues;
  PRINT E[E.title AS title, E.year AS year, E.date_text AS date, E.gold AS gold, E.gold_noc AS gold_noc] AS events;
}

// Full neighbourhood of one event: games, venue, medallists, nations, previous / next edition
CREATE OR REPLACE QUERY event_profile(STRING eid) FOR GRAPH @GRAPH@ {
  SetAccum<STRING> @@prev, @@next;
  ListAccum<STRING> @@medals;
  S = {Event.*};
  S = SELECT e FROM S:e WHERE e.id == eid;
  P = SELECT p FROM S:e -(PREV_EDITION>)- Event:p ACCUM @@prev += p.id + " | " + p.title;
  N = SELECT n FROM S:e -(NEXT_EDITION>)- Event:n ACCUM @@next += n.id + " | " + n.title;
  A = SELECT a FROM S:e -(WON_MEDAL:w)- Athlete:a ACCUM @@medals += w.medal + ": " + a.name;
  PRINT S AS event;
  PRINT @@medals AS medallists, @@prev AS previous_edition, @@next AS next_edition;
}

// Temporal hop along the edition chain (direction "prev" or "next"), `hops` steps
CREATE OR REPLACE QUERY edition_hop(STRING eid, STRING direction, INT hops) FOR GRAPH @GRAPH@ {
  S = {Event.*};
  S = SELECT e FROM S:e WHERE e.id == eid;
  FOREACH i IN RANGE[1, hops] DO
    IF direction == "prev" THEN
      S = SELECT p FROM S:e -(PREV_EDITION>)- Event:p;
    ELSE
      S = SELECT n FROM S:e -(NEXT_EDITION>)- Event:n;
    END;
  END;
  PRINT S[S.title AS title, S.year AS year, S.venue AS venue, S.date_text AS date, S.gold AS gold,
          S.silver AS silver, S.bronze AS bronze, S.competitors AS competitors, S.nations AS nations] AS events;
}

// Graph-native aggregation: count / rank events of a sport at one Games by competitor numbers
CREATE OR REPLACE QUERY aggregate_events(STRING sport_norm, INT year, STRING season, INT threshold) FOR GRAPH @GRAPH@ {
  SumAccum<INT> @@over, @@total, @@missing;
  MaxAccum<INT> @@max_c;
  SetAccum<STRING> @@argmax;
  G = {Games.*};
  G = SELECT g FROM G:g WHERE g.year == year AND g.season == season;
  E = SELECT e FROM G:g -(IN_GAMES)- Event:e WHERE e.sport_norm == sport_norm
      ACCUM @@total += 1,
            IF e.competitors < 0 THEN @@missing += 1 END,
            IF e.competitors > threshold THEN @@over += 1 END,
            @@max_c += e.competitors;
  M = SELECT e FROM E:e WHERE e.competitors == @@max_c AND @@max_c >= 0 ACCUM @@argmax += e.title;
  PRINT @@total AS events_found, @@over AS over_threshold, @@max_c AS max_competitors,
        @@argmax AS max_events, @@missing AS events_without_count;
  PRINT E[E.title AS title, E.competitors AS competitors] AS events;
}

// Athlete -> events they medalled in
CREATE OR REPLACE QUERY athlete_medals(STRING name_like) FOR GRAPH @GRAPH@ {
  A = {Athlete.*};
  A = SELECT a FROM A:a WHERE a.id LIKE "%" + name_like + "%" LIMIT 20;
  E = SELECT e FROM A:a -(WON_MEDAL:w)- Event:e;
  PRINT A[A.name AS name] AS athletes;
  PRINT E[E.title AS title, E.gold AS gold, E.silver AS silver, E.bronze AS bronze] AS events;
}

// Catalogue for entity linking (sports, venues, games)
CREATE OR REPLACE QUERY catalog() FOR GRAPH @GRAPH@ {
  S = {Sport.*};
  V = {Venue.*};
  G = {Games.*};
  PRINT S[S.name AS name] AS sports, V[V.name AS name] AS venues, G[G.year AS year, G.season AS season] AS games;
}

// Reasoning over time: every version of an event's facts and which supersedes which
CREATE OR REPLACE QUERY event_claims(STRING eid) FOR GRAPH @GRAPH@ {
  SetAccum<STRING> @@supersedes;
  S = {Event.*};
  S = SELECT e FROM S:e WHERE e.id == eid;
  C = SELECT c FROM S:e -(HAS_CLAIM)- Claim:c;
  X = SELECT c FROM C:c -(SUPERSEDES>)- Claim:o ACCUM @@supersedes += c.id + " > " + o.id;
  PRINT S[S.title AS title] AS event;
  PRINT C AS claims;
  PRINT @@supersedes AS supersedes;
}

// Round 2: source records about one event (time order and tiers are applied in code)
CREATE OR REPLACE QUERY event_sources(STRING eid) FOR GRAPH @GRAPH@ {
  S = {Event.*};
  S = SELECT e FROM S:e WHERE e.id == eid;
  R = SELECT r FROM S:e -(ABOUT_EVENT)- SourceRecord:r;
  PRINT S[S.title AS title] AS event;
  PRINT R[R.title AS title, R.source AS source, R.published AS published, R.published_utc AS published_utc,
          R.tier AS tier, R.tier_label AS tier_label, R.body AS body] AS records;
}

// Round 2: every source record, optionally only those published up to a UTC cut-off ("YYYY-MM-DD HH:MM:SS")
CREATE OR REPLACE QUERY list_sources(STRING published_before) FOR GRAPH @GRAPH@ {
  R = {SourceRecord.*};
  R = SELECT r FROM R:r WHERE published_before == "" OR r.published_utc <= to_datetime(published_before);
  PRINT R[R.title AS title, R.source AS source, R.published AS published, R.published_utc AS published_utc,
          R.tier AS tier, R.tier_label AS tier_label, R.body AS body] AS records;
}

// Round 2 cross-Games: every medal of one colour (default gold) per athlete, optionally for one sport / season;
// repeat winners of the same event are found in code (agr/crossgames.py)
CREATE OR REPLACE QUERY athlete_medal_rows(STRING sport_norm, STRING season, STRING medal) FOR GRAPH @GRAPH@ {
  ListAccum<STRING> @rows;
  E = {Event.*};
  E = SELECT e FROM E:e WHERE (sport_norm == "" OR e.sport_norm == sport_norm) AND (season == "" OR e.season == season);
  A = SELECT a FROM E:e -(WON_MEDAL:w)- Athlete:a WHERE medal == "" OR w.medal == medal
      ACCUM a.@rows += e.id + "|" + to_string(e.year) + "|" + e.season + "|" + e.sport + "|" + e.event + "|" + w.medal;
  PRINT A[A.name AS name, A.@rows AS rows] AS athletes;
}

// Round 2 cross-Games: every edition of one event (same sport + event name) with its nations / competitors
CREATE OR REPLACE QUERY event_editions(STRING sport_norm, STRING event_norm, STRING season) FOR GRAPH @GRAPH@ {
  E = {Event.*};
  E = SELECT e FROM E:e WHERE e.event_norm == event_norm AND (sport_norm == "" OR e.sport_norm == sport_norm)
                              AND (season == "" OR e.season == season);
  PRINT E[E.title AS title, E.sport AS sport, E.year AS year, E.season AS season, E.nations AS nations,
          E.competitors AS competitors, E.gold AS gold] AS events;
}

// Round 2: medals per nation in one sport at one Games, counted with accumulators over the events' medal fields
// (one event can give two medals to the same nation, so the NOC attributes are counted, not MEDAL_FOR edges);
// each entry carries the event and the medallist(s)
CREATE OR REPLACE QUERY medal_table(STRING sport_norm, INT year, STRING season, STRING medal) FOR GRAPH @GRAPH@ {
  MapAccum<STRING, SumAccum<INT>> @@count;
  MapAccum<STRING, ListAccum<STRING>> @@events;
  SumAccum<INT> @@n_events;
  G = {Games.*};
  G = SELECT g FROM G:g WHERE g.year == year AND (season == "" OR g.season == season);
  E = SELECT e FROM G:g -(IN_GAMES)- Event:e WHERE sport_norm == "" OR e.sport_norm == sport_norm
      ACCUM @@n_events += 1,
            IF (medal == "" OR medal == "gold") AND e.gold_noc != "" THEN
              @@count += (e.gold_noc -> 1), @@events += (e.gold_noc -> e.id + "|" + e.event + "|gold|" + e.gold) END,
            IF (medal == "" OR medal == "silver") AND e.silver_noc != "" THEN
              @@count += (e.silver_noc -> 1), @@events += (e.silver_noc -> e.id + "|" + e.event + "|silver|" + e.silver) END,
            IF (medal == "" OR medal == "bronze") AND e.bronze_noc != "" THEN
              @@count += (e.bronze_noc -> 1), @@events += (e.bronze_noc -> e.id + "|" + e.event + "|bronze|" + e.bronze) END;
  PRINT @@n_events AS events_found, @@count AS medals_by_nation, @@events AS events_by_nation;
}

// Round 2: every event of one sport (or all sports) at one Games with its counts and winners, for ranking in code
CREATE OR REPLACE QUERY games_events(STRING sport_norm, INT year, STRING season) FOR GRAPH @GRAPH@ {
  G = {Games.*};
  G = SELECT g FROM G:g WHERE g.year == year AND (season == "" OR g.season == season);
  E = SELECT e FROM G:g -(IN_GAMES)- Event:e WHERE sport_norm == "" OR e.sport_norm == sport_norm;
  PRINT E[E.title AS title, E.sport AS sport, E.event AS event, E.year AS year, E.season AS season,
          E.nations AS nations, E.competitors AS competitors, E.gold AS gold, E.gold_noc AS gold_noc] AS events;
}

// Round 2: exact phrase search over all chunk text (case-insensitive), e.g. a film title inside a person's article
CREATE OR REPLACE QUERY text_search(STRING needle, INT lim) FOR GRAPH @GRAPH@ {
  C = {Chunk.*};
  C = SELECT c FROM C:c WHERE lower(c.text) LIKE "%" + lower(needle) + "%" LIMIT lim;
  PRINT C[C.doc_id AS doc_id, C.idx AS idx, C.text AS text] AS hits;
}

// Round 2: films by title, by a credited person (director, starring, music, ...) and/or by release year range
CREATE OR REPLACE QUERY film_facts(STRING title_norm, STRING person_norm, STRING role, INT year_from, INT year_to)
    FOR GRAPH @GRAPH@ {
  SetAccum<STRING> @credits;
  F = {Film.*};
  IF person_norm != "" THEN
    P = {Person.*};
    P = SELECT p FROM P:p WHERE p.id == person_norm;
    F = SELECT f FROM P:p -(FILM_CREDIT:c)- Film:f WHERE role == "" OR c.role LIKE "%" + role + "%";
  END;
  F = SELECT f FROM F:f
      WHERE (title_norm == "" OR f.title_norm LIKE "%" + title_norm + "%")
        AND (year_from <= 0 OR f.year >= year_from) AND (year_to <= 0 OR f.year <= year_to);
  X = SELECT f FROM F:f -(FILM_CREDIT:c)- Person:p ACCUM f.@credits += c.role + ": " + p.name;
  PRINT F[F.title AS title, F.name AS name, F.year AS year, F.released AS released, F.director AS director,
          F.starring AS starring, F.music AS music, F.country AS country, F.runtime_min AS runtime_min,
          F.budget AS budget, F.gross AS gross, F.budget_currency AS budget_currency, F.budget_low AS budget_low,
          F.budget_high AS budget_high, F.gross_currency AS gross_currency, F.gross_low AS gross_low,
          F.gross_high AS gross_high, F.gross_note AS gross_note, F.@credits AS credits] AS films;
}

// Round 2: offices held by a person (or every holder of an office), with predecessor, successor and the linked
// previous / next terms of the same office
CREATE OR REPLACE QUERY office_succession(STRING person_norm, STRING office_like) FOR GRAPH @GRAPH@ {
  SetAccum<STRING> @holder, @prev_term, @next_term;
  T = {OfficeTerm.*};
  IF person_norm != "" THEN
    P = {Person.*};
    P = SELECT p FROM P:p WHERE p.id == person_norm;
    T = SELECT t FROM P:p -(HELD)- OfficeTerm:t;
  END;
  T = SELECT t FROM T:t WHERE office_like == "" OR t.office_key LIKE "%" + office_like + "%";
  H = SELECT t FROM T:t -(HELD)- Person:p ACCUM t.@holder += p.name;
  A = SELECT t FROM T:t -(PREV_TERM>)- OfficeTerm:o ACCUM t.@prev_term += o.id;
  B = SELECT t FROM T:t -(NEXT_TERM>)- OfficeTerm:o ACCUM t.@next_term += o.id;
  PRINT T[T.@holder AS holder, T.office AS office, T.term_start AS term_start, T.term_end AS term_end,
          T.start_year AS start_year, T.end_year AS end_year, T.predecessor AS predecessor, T.successor AS successor,
          T.doc_id AS doc_id, T.@prev_term AS prev_term, T.@next_term AS next_term] AS terms;
}

INSTALL QUERY ALL
