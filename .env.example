# ---- TigerGraph (Savanna or Community Edition) ----
TG_HOST=https://<your-workspace>.i.tgcloud.io
TG_SECRET=<savanna secret>
# optional: a ready-made token instead of the secret
# TG_TOKEN=
TG_GRAPH=OlympicRAG2
# mcp: every installed query goes through the official TigerGraph MCP server (RESTPP fallback is automatic); rest: RESTPP only
TG_TRANSPORT=mcp
# optional: print every MCP call as it happens (demos)
# TG_MCP_LOG=1
# optional: command that starts the MCP server (default: this Python, -m tigergraph_mcp.main)
# TG_MCP_COMMAND=
# only behind an HTTPS proxy (sandboxed networks)
# TG_MCP_TRUST_ENV=1
# optional: where the TigerGraph query log is written (default logs/tigergraph_queries.jsonl)
# TG_QUERY_LOG=

# ---- LLM ----
# gemini | anthropic | openai
LLM_PROVIDER=gemini
# optional: model for the chosen provider (defaults: gemini-3.1-flash-lite, claude-haiku-5-5, gpt-5-mini)
# LLM_MODEL=
# Gemini (https://aistudio.google.com/apikey); GEMINI_MODEL is still read when LLM_MODEL is unset
GEMINI_API_KEY=<key>
GEMINI_MODEL=gemini-3.1-flash-lite
# optional: more Gemini keys, rotated when one key's daily free-tier quota is used up
# (GEMINI_API_KEYS=key1,key2 and/or GEMINI_API_KEY2=..., GEMINI_API_KEY3=...)
# GEMINI_API_KEYS=key1,key2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# optional: an OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# model for scripts/score_public.py --judge (default: the system model)
JUDGE_MODEL=gemini-3.1-flash-lite

# ---- rate limiting and cost ----
# requests per minute allowed by the provider (Gemini free tier: 15; 0 = no limit). Waits happen before a question starts.
LLM_RPM=15
# request slots that must be free before a question starts
LLM_CALLS_RESERVED=6
# seconds before a hung LLM request is abandoned and retried (Gemini)
LLM_TIMEOUT_S=45
# fixed sampling seed for LLM calls (Gemini, OpenAI); with temperature 0 it reduces run-to-run variation
LLM_SEED=7
# USD per million tokens, for cost_usd_total in metrics.json (0 on a free tier)
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# ---- agent ----
MAX_AGENT_STEPS=8
RAG_K=8
